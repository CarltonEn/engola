# Copy to .env and fill in. Never commit .env.

ENGOLA_OWNER_NAME=Carlton
ENGOLA_HOST=127.0.0.1
ENGOLA_PORT=8765
# Optional extra lock -- set this to a random string and the app will
# require ?token=<it> once (a cookie carries it after). Recommended once
# you're using /device or /mail. Leave blank while you're just testing.
ENGOLA_ACCESS_TOKEN=

# --- Chat engines: only the ones with a key show up as usable in the UI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

XAI_API_KEY=
XAI_MODEL=grok-4

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

ENGOLA_DEFAULT_ENGINE=gemini

# --- Tools ---
BRAVE_SEARCH_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Gmail (OAuth "Desktop app" client -- see integrations/google_oauth.py) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram: archive-only now, not the chat UI. Both required to enable it. ---
TELEGRAM_BOT_TOKEN=
ARCHIVE_CHAT_ID=

# Seconds a single shell command may run before being killed.
ENGOLA_SHELL_TIMEOUT=120
# How many back-and-forth turns of short-term chat memory to keep.
ENGOLA_HISTORY_TURNS=16
# How many long-term memories to retrieve per message.
ENGOLA_KNOWLEDGE_TOP_K=5
